# Server
PORT=4000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# Postgres — use the shared app database
# This should point to the same Postgres instance as db/postgres/scripts/init_db.sh
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/argonyx

# JWT
JWT_ACCESS_SECRET=replace_with_a_long_random_string
JWT_REFRESH_SECRET=replace_with_a_different_long_random_string
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7

# Cookies
COOKIE_SECURE=false
COOKIE_DOMAIN=localhost

# Google OAuth (from Google Cloud Console > Credentials)
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:4000/api/auth/google/callback
